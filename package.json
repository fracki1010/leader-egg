{
  "name": "leader-egg-back",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented Express and MongoDB API service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed.ts",
    "tenants:list": "tsx src/scripts/list-tenants.ts",
    "tenant:reset": "tsx src/scripts/reset-all.ts",
    "tenant:promote": "tsx src/scripts/promote-admin.ts",
    "permissions:backfill": "tsx src/scripts/backfill-permissions.ts",
    "orders:backfill-date": "tsx src/scripts/backfill-order-date.ts",
    "dates:normalize": "tsx src/scripts/normalize-date-only-dates.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
