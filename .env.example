PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/leader_egg
# Platform (master) DB name — holds the tenant registry, email index and platform
# admins. Resolved via `useDb` on the MONGO_URI cluster (same host). Defaults to
# leader_egg_platform. Tenant #1 keeps using the `leader_egg` database.
PLATFORM_DB=leader_egg_platform
CORS_ORIGIN=*
JWT_SECRET=change-me-to-a-secure-random-string
# Dedicated secret for platform (super-tenant) tokens. Optional: when unset it
# derives from JWT_SECRET as "${JWT_SECRET}__platform". Set a DISTINCT random
# value in production so a leaked tenant JWT_SECRET cannot mint platform tokens.
# Changing it invalidates existing platform sessions.
PLATFORM_JWT_SECRET=change-me-to-a-different-secure-random-string
JWT_EXPIRES_IN=24h

# ── Login rate limiting ──────────────────────────────────────────────────────
# Brute-force protection for POST /v1/auth/login (tenant) and
# POST /v1/platform/auth/login (platform). Successful logins do NOT consume the
# budget; only failed attempts count. Keys are client IP + normalized email.
#
# Storage: in-memory by default. That is correct ONLY while the API runs as a
# SINGLE container — with multiple replicas each one counts independently and
# the effective limit becomes max × replicas. Set REDIS_URL before scaling out.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
# Platform (master panel) login is stricter by default.
PLATFORM_LOGIN_RATE_LIMIT_WINDOW_MS=900000
PLATFORM_LOGIN_RATE_LIMIT_MAX=5
